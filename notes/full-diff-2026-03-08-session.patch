+/// Remove middle vertex B when A,B,C are nearly collinear and B lies between A and C.
+/// `epsilon` is the max absolute cross-product value (in extent units²).
+fn remove_near_collinear(ring: &mut Vec<(i32, i32)>, epsilon: i64) {
+    if ring.len() < 4 {
+        return;
+    }
+    let mut i = 0;
+    while i + 2 < ring.len() {
+        let a = ring[i];
+        let b = ring[i + 1];
+        let c = ring[i + 2];
+        let cross = i64::from(b.0 - a.0) * i64::from(c.1 - a.1)
+                   - i64::from(b.1 - a.1) * i64::from(c.0 - a.0);
+        if cross.abs() <= epsilon && point_between(a, b, c) {
+            ring.remove(i + 1);
+            // Don't advance — check new triple at same position
+        } else {
+            i += 1;
+        }
+    }
