+fn find_prev(i: usize, n: usize, keep: &[bool]) -> usize {
+    let mut p = if i == 0 { n - 1 } else { i - 1 };
+    let start = p;
+    while !keep[p] {
+        p = if p == 0 { n - 1 } else { p - 1 };
+        if p == start { return i; }
+    }
+    p
+}
