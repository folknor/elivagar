+    // Feature 2 exterior
+    assert_eq!(coords[8], (2000, 2000));
+    assert_eq!(coords[9], (3000, 2000));
+    // Feature 2 hole
+    assert_eq!(coords[12], (2100, 2100));
+    assert_eq!(coords[13], (2900, 2100));
+}
