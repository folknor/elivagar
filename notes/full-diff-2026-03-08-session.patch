+/// Post-merge ring cleanup for ocean polygons. Runs to fixed-point (max 3 iterations):
+///   1. Remove consecutive duplicate vertices
+///   2. Remove exact A→B→A backtracks
+///   3. Collapse nearly-collinear vertices (epsilon cross-product test)
+///   4. Drop micro-area rings (< 4px² = 1024 extent² units)
+///
+/// Does not fix topology (self-intersections), but kills tile-edge zipper slivers
+/// and other merge artifacts.
+fn cleanup_ocean_rings(lb: &mut LayerBuilder) {
+    // 4 pixels² — generous threshold for ocean cleanup. Regular emit uses 1px².
+    const MICRO_AREA: i64 = 4 * 256; // 4 * (16²) = 1024 extent² units
+
+    for feat in lb.features_mut() {
+        if feat.geom_type != GeomType::Polygon {
+            continue;
+        }
+        let mut rings = geometry::decode_mvt_polygon(&feat.geometry);
+        let original_geom_len = feat.geometry.len();
+        let original_ring_count = rings.len();
+
+        // Fixed-point iteration (max 3 rounds).
+        for _ in 0..3 {
+            let snapshot: usize = rings.iter().map(Vec::len).sum();
+
+            for ring in &mut rings {
+                // 1. Consecutive duplicates.
+                ring.dedup();
+
+                // 2. Exact A→B→A backtracks.
+                remove_backtracks(ring);
+
+                // 3. Near-collinear collapse: remove B when A,B,C have
+                //    |cross(AB,AC)| ≤ epsilon and B is between A and C.
+                //    Epsilon of 16 = 1 pixel in extent units — catches slivers
+                //    that are sub-pixel wide but span the full tile edge.
+                remove_near_collinear(ring, 16);
+
+                // Re-close if needed.
+                if ring.len() >= 2 && ring.first() != ring.last()
+                    && let Some(&first) = ring.first()
+                {
+                    ring.push(first);
+                }
+            }
+
+            // 4. Drop degenerate (<4 pts closed), micro-area, sub-pixel-thin,
+            //    and non-simple rings. Non-simple rings cause earcut tessellation
+            //    failures in MapLibre (garbage triangles).
+            rings.retain(|r| {
+                if r.len() < 4 { return false; }
+                if ring_area_abs_i32(r) < MICRO_AREA { return false; }
+                // Drop rings whose bbox is sub-pixel in either dimension.
+                // Catches tall-but-thin slivers that pass the area check.
+                let (mut min_x, mut min_y) = r[0];
+                let (mut max_x, mut max_y) = r[0];
+                for &(x, y) in &r[1..] {
+                    if x < min_x { min_x = x; }
+                    if x > max_x { max_x = x; }
+                    if y < min_y { min_y = y; }
+                    if y > max_y { max_y = y; }
+                }
+                // 1 pixel = 16 extent units
+                if (max_x - min_x) < 16 || (max_y - min_y) < 16 { return false; }
+                // Final validity gate: never emit self-intersecting rings.
+                geometry::ring_is_simple(r)
+            });
+
+            let after: usize = rings.iter().map(Vec::len).sum();
+            if after == snapshot && rings.len() == original_ring_count {
+                break; // stable
+            }
+        }
+
+        // Only re-encode if something changed.
+        let new_total: usize = rings.iter().map(Vec::len).sum();
+        let total_changed = rings.len() != original_ring_count
+            || new_total != original_geom_len; // rough proxy
+        if total_changed {
+            let ring_refs: Vec<&[(i32, i32)]> = rings.iter().map(Vec::as_slice).collect();
+            feat.geometry.clear();
+            mvt::encode_polygon(&mut feat.geometry, &ring_refs);
+        }
+    }
+}
