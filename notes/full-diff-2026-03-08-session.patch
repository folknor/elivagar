+fn find_next(i: usize, n: usize, keep: &[bool]) -> usize {
+    let mut p = (i + 1) % n;
+    let start = p;
+    while !keep[p] {
+        p = (p + 1) % n;
+        if p == start { return i; }
+    }
+    p
