+// ---------------------------------------------------------------------------
+// Earcut-safety ring cleanup (post-quantization quality pass)
+// ---------------------------------------------------------------------------
+// Earcut tessellation can produce garbage triangles from rings that are
+// technically simple but contain near-degenerate features: tiny spikes,
+// micro-edges, near-collinear zigzags. This pass removes those artifacts.
+
+/// Minimum triangle area (2× signed area) for a vertex to survive cleanup.
+/// 1 pixel = 16 extent units → 1 pixel² = 16×16 = 256 extent² units.
+/// Using 2× area to avoid the /2 in the shoelace formula.
+const SPIKE_AREA_THRESHOLD: i64 = 256;
+
+/// Minimum squared edge length to keep. Edges shorter than ~2 extent units
+/// (0.125 rendered pixels) are micro-edges that create zigzag artifacts.
+const MIN_EDGE_LEN_SQ: i64 = 4;
+
+/// Clean a closed tile-coordinate polygon ring by removing degenerate features
+/// that confuse earcut tessellation.
+///
+/// Removes: consecutive near-duplicates, tiny spikes (vertex creating negligible
+/// triangle area with neighbors), and micro-edge zigzags. Iterates until stable.
+/// Preserves ring closure and minimum vertex count.
+pub(crate) fn cleanup_tile_ring(ring: &mut Vec<(i32, i32)>, min_points: usize) {
+    if ring.len() <= min_points {
+        return;
+    }
+    let closed = ring.first() == ring.last();
+
+    // Iterative cleanup: each pass may expose new degenerate triples.
+    // Converges quickly (usually 1-2 passes).
+    for _ in 0..10 {
+        let before = ring.len();
+        cleanup_pass(ring, min_points, closed);
+        if ring.len() == before || ring.len() <= min_points {
+            break;
+        }
+    }
