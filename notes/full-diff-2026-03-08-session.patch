+
+fn cleanup_pass(ring: &mut Vec<(i32, i32)>, min_points: usize, closed: bool) {
+    let n = if closed { ring.len() - 1 } else { ring.len() };
+    if n <= min_points {
+        return;
+    }
+
+    let mut keep = vec![true; n];
+    let mut removed = 0;
+
+    for i in 0..n {
+        if !keep[i] { continue; }
+
+        // Find actual prev and next (skipping already-removed vertices)
+        let prev = find_prev(i, n, &keep);
+        let next = find_next(i, n, &keep);
+        if prev == i || next == i { continue; }
+
+        let (ax, ay) = (i64::from(ring[prev].0), i64::from(ring[prev].1));
+        let (bx, by) = (i64::from(ring[i].0), i64::from(ring[i].1));
+        let (cx, cy) = (i64::from(ring[next].0), i64::from(ring[next].1));
+
+        // Check 1: micro-edge — current vertex nearly coincident with neighbor
+        let d_prev_sq = (bx - ax) * (bx - ax) + (by - ay) * (by - ay);
+        let d_next_sq = (cx - bx) * (cx - bx) + (cy - by) * (cy - by);
+        if (d_prev_sq < MIN_EDGE_LEN_SQ || d_next_sq < MIN_EDGE_LEN_SQ)
+            && n - removed > min_points
+        {
+            keep[i] = false;
+            removed += 1;
+            continue;
+        }
+
+        // Check 2: tiny spike — triangle area with neighbors is negligible
+        let cross = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
+        if cross.abs() < SPIKE_AREA_THRESHOLD
+            && n - removed > min_points
+        {
+            keep[i] = false;
+            removed += 1;
+        }
+    }
