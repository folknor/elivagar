+/// Debug: check ocean layer rings for geometry defects and log any problems.
+fn debug_check_ocean_layer(label: &str, tile_id: u64, layers: &[Option<LayerBuilder>]) {
+    let (z, x, y) = pmtiles_writer::tile_id_to_zxy(tile_id);
+    if let Some(lb) = layers[shortbread::Layer::Ocean as usize].as_ref() {
+        for (fi, feat) in lb.features().iter().enumerate() {
+            let rings = geometry::decode_mvt_polygon(&feat.geometry);
+            let problems = geometry::debug_check_rings(&rings);
+            if !problems.is_empty() {
+                eprintln!("[assemble-{label}] z={z} x={x} y={y} feat={fi} rings={}:", rings.len());
+                for p in &problems {
+                    eprintln!("  {p}");
+                }
+            }
+        }
+    }
+}
