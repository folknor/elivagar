+    if removed == 0 { return; }
+
+    // Compact in-place
+    let mut write = 0;
+    for read in 0..n {
+        if keep[read] {
+            ring[write] = ring[read];
+            write += 1;
+        }
+    }
+    if closed {
+        ring[write] = ring[0];
+        write += 1;
+    }
+    ring.truncate(write);
