+/// Remove exact A→B→A backtracks from a ring (in-place, iterate until stable).
+fn remove_backtracks(ring: &mut Vec<(i32, i32)>) {
+    loop {
+        let mut found = false;
+        let mut i = 0;
+        while i + 2 < ring.len() {
+            if ring[i] == ring[i + 2] && ring[i] != ring[i + 1] {
+                ring.remove(i + 1);
+                ring.remove(i + 1);
+                found = true;
+            } else {
+                i += 1;
+            }
+        }
+        if !found { break; }
+    }
